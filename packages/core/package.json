{
    "name": "geo-select-core",
    "version": "0.4.7",
    "description": "Vanilla JS core for interactive world map region selection",
    "type": "module",
    "main": "dist/geo-select-core.cjs",
    "module": "dist/geo-select-core.esm.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/geo-select-core.esm.js",
            "require": "./dist/geo-select-core.cjs",
            "default": "./dist/geo-select-core.esm.js"
        },
        "./world": {
            "types": "./dist/world.d.ts",
            "import": "./dist/world.esm.js",
            "require": "./dist/world.cjs",
            "default": "./dist/world.esm.js"
        }
    },
    "files": [
        "DATA_LICENSE.md",
        "dist/*.d.ts",
        "dist/geo-select-core.cjs",
        "dist/geo-select-core.cjs.map",
        "dist/geo-select-core.esm.js",
        "dist/geo-select-core.esm.js.map",
        "dist/geo-select-core.umd.js",
        "dist/geo-select-core.umd.js.map",
        "dist/world.cjs",
        "dist/world.cjs.map",
        "dist/world.esm.js",
        "dist/world.esm.js.map"
    ],
    "scripts": {
        "build": "rollup -c",
        "clean": "rm -rf dist",
        "prepare": "npm run build",
        "test": "npm run build && node --test test/*.test.mjs && node scripts/check-package.mjs"
    },
    "keywords": [
        "geo",
        "map",
        "select",
        "country",
        "region"
    ],
    "license": "MIT",
    "devDependencies": {
        "@rollup/plugin-commonjs": "^29.0.0",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "jsdom": "^30.0.1",
        "rollup": "^4.52.5",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@types/geojson": "^7946.0.16",
        "tslib": "^2.8.1"
    }
}
